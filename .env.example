# Copy to .env and fill in as needed. .env is gitignored.

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Alert channels (all optional; leave blank to disable) ---
# Telegram: get a bot token from @BotFather + the chat id of the channel/DM.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Slack: incoming-webhook URL (Workspace settings → Apps → Incoming WebHooks).
SLACK_WEBHOOK_URL=
# Discord: server settings → Integrations → Webhooks.
DISCORD_WEBHOOK_URL=

# --- Hugging Face model repo (optional) ---
# Set if you want `scripts/download_model.py` to pull a pre-trained generalist.
# Example: your-user/trademaster-rl-generalist
HF_MODEL_REPO=
HF_MODEL_REV=main

# --- Reddit OAuth (optional, but Reddit blocks anonymous since 2024) ---
# Register a "script" app at https://www.reddit.com/prefs/apps  (free, 2 min).
# Client ID is the string under your app name; secret is the one labelled secret.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TradeMaster/0.1 (by /u/yourname)

# --- Guardrail limits (optional) ---
MAX_POSITION_PCT=0.20
MAX_ORDER_PCT=0.10
MAX_DAILY_LOSS_PCT=0.05
MAX_PORTFOLIO_EXPOSURE_PCT=0.60
TRADE_RATE_LIMIT=10
TRADE_RATE_WINDOW=60
EVENT_WINDOW_LOCK=1
