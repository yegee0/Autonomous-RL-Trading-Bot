# Copy to .env and fill in as needed. .env is gitignored.

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Telegram (optional) ---
# Get a bot token from @BotFather; leave blank to disable push alerts.
TELEGRAM_BOT_TOKEN=

# --- Hugging Face model repo (optional) ---
# Set if you want `scripts/download_model.py` to pull a pre-trained generalist.
# Example: your-user/trademaster-rl-generalist
HF_MODEL_REPO=
HF_MODEL_REV=main
